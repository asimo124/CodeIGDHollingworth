# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore Composer
/vendor/
composer.lock

# Ignore CodeIgniter specific
/app/writable/cache/*
!/app/writable/cache/index.html
/app/writable/logs/*
!/app/writable/logs/index.html
/app/writable/session/*
!/app/writable/session/index.html
/app/writable/uploads/*
!/app/writable/uploads/index.html
/app/writable/debugbar/*
!/app/writable/debugbar/index.html

# Ignore environment files
/app/.env
!/app/env

# Ignore MySQL data
mysql_data/

# Ignore user guides and docs
/app/user_guide_src/build/
/app/user_guide_src/cilexer/build/
/app/user_guide_src/cilexer/dist/
/app/user_guide_src/cilexer/pycilexer.egg-info/

# Ignore PHPUnit
/app/phpunit*.xml
/app/.phpunit.*.cache
